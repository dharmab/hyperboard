{
  "name": "hyperboard",
  "private": true,
  "packageManager": "bun@1.4.3",
  "scripts": {
    "lint": "bun --bun eslint . --max-warnings 0 && bun run format:check",
    "format": "bun fmt '**/*.{js,mjs,cjs}'",
    "format:check": "bun fmt --check '**/*.{js,mjs,cjs}'"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.13.0"
  }
}
